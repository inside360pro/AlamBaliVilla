        // Base64 Calendar IDs corresponding to the 3 shared Google Calendars (Read-Only Public Embeds)
        const CALENDAR_SOURCES = {
            1: 'ZjE2ZmNhNTIzMDM5ZTBiMmJkY2Y0M2FlM2VlMDQ5M2ViMDBiZWE3Zjk5MTkyNzNjZTNjMjc2ODIxYTRjZDMyZkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t',
            2: 'ZGNlZGY0ODhhZjJmZDkxZjZhNWJhNWRiNTk5YTBlM2M3NzRiNjg1MjlkNzcxNjU0MGIyNjczZjlhMzM5YWNiNkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t',
            3: 'NGE2NTBiNjc0NGFlMWExNTEyYTgwYmIxNWNiM2Y5OTQ5NDcwNGMwOTc4ZWMxOTgxODI3MmE2ZjI5ZTBjNWZmYUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t'
        };

        let currentViewMode = 'MONTH'; // 'MONTH', 'AGENDA', or 'WEEK'
        let autoRefreshEnabled = true;
        let countdownValue = 15;
        let countdownInterval = null;
        let previousSnapshot = null;

        function buildEmbedUrl(roomNum, mode, cacheBust) {
            const src = CALENDAR_SOURCES[roomNum];
            return `https://calendar.google.com/calendar/embed?height=540&wkst=1&ctz=Asia%2FMakassar&showPrint=0&showTabs=1&showCalendars=0&showTz=1&mode=${mode}&src=${src}&color=%23D4AF37&_cb=${cacheBust}`;
        }

        function formatTimeNow() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const ss = String(now.getSeconds()).padStart(2, '0');
            return `${hh}:${mm}:${ss}`;
        }

        function setCalendarViewMode(mode) {
            currentViewMode = mode;
            document.querySelectorAll('.view-mode-btn').forEach(btn => {
                btn.classList.remove('bg-luxuryGold', 'text-luxuryGrey-dark', 'font-bold');
                btn.classList.add('text-gray-300', 'font-semibold');
            });
            const activeBtn = document.getElementById(`mode-btn-${mode}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-gray-300', 'font-semibold');
                activeBtn.classList.add('bg-luxuryGold', 'text-luxuryGrey-dark', 'font-bold');
            }
            reloadAllIframes();
        }

        function refreshSingleCalendar(roomNum) {
            const iframe = document.getElementById(`gcal-iframe-${roomNum}`);
            if (iframe) {
                iframe.src = buildEmbedUrl(roomNum, currentViewMode, Date.now());
            }
            const statusLog = document.getElementById('sync-status-log');
            if (statusLog) {
                statusLog.innerText = `Status: Manually reloaded Deluxe ${roomNum} calendar at ${formatTimeNow()}`;
            }
        }

        function reloadAllIframes() {
            const ts = Date.now();
            [1, 2, 3].forEach(roomNum => {
                const iframe = document.getElementById(`gcal-iframe-${roomNum}`);
                if (iframe) {
                    iframe.src = buildEmbedUrl(roomNum, currentViewMode, ts + roomNum);
                }
            });
        }

        async function checkCalendarChangesAndSync(forceReload = false) {
            const icon = document.getElementById('refresh-btn-icon');
            if (icon) icon.classList.add('fa-spin');

            const checkedEl = document.getElementById('last-checked-time');
            const statusLog = document.getElementById('sync-status-log');
            const nowStr = formatTimeNow();
            if (checkedEl) checkedEl.innerText = nowStr;

            let detectedChanges = [];
            let fetchedLiveState = false;

            try {
                const endpoints = [
                    '/.netlify/functions/get_availability_function',
                    '/.netlify/functions/get-availability'
                ];

                for (const url of endpoints) {
                    try {
                        const response = await fetch(`${url}?t=${Date.now()}`);
                        if (!response.ok) continue;
                        const data = await response.json();
                        if (data && data.success && data.bookedDates) {
                            fetchedLiveState = true;
                            const currentSnapshot = {
                                1: [...(data.bookedDates[1] || [])].sort(),
                                2: [...(data.bookedDates[2] || [])].sort(),
                                3: [...(data.bookedDates[3] || [])].sort()
                            };

                            if (previousSnapshot !== null) {
                                [1, 2, 3].forEach(roomNum => {
                                    const prevSet = new Set(previousSnapshot[roomNum]);
                                    const currSet = new Set(currentSnapshot[roomNum]);
                                    const added = currentSnapshot[roomNum].filter(d => !prevSet.has(d));
                                    const removed = previousSnapshot[roomNum].filter(d => !currSet.has(d));

                                    if (added.length > 0 || removed.length > 0) {
                                        let summary = `Deluxe ${roomNum}: `;
                                        const parts = [];
                                        if (added.length > 0) parts.push(`+${added.length} date(s) added (${added.slice(0, 3).join(', ')}${added.length > 3 ? '...' : ''})`);
                                        if (removed.length > 0) parts.push(`-${removed.length} date(s) cleared`);
                                        summary += parts.join(', ');
                                        detectedChanges.push({ roomNum, summary });
                                    }
                                });
                            }

                            previousSnapshot = currentSnapshot;
                            break;
                        }
                    } catch (e) {
                        // Continue to fallback endpoint or direct iframe reload
                    }
                }
            } catch (err) {
                console.warn('Availability poll warning:', err);
            }

            // Reload all 3 Google Calendar iframes on manual refresh, on detected change, or on every 15-second cycle
            reloadAllIframes();

            if (detectedChanges.length > 0) {
                showChangeNotification(detectedChanges, nowStr);
                if (statusLog) {
                    statusLog.innerText = `CHANGE DETECTED (${nowStr}): ${detectedChanges.map(c => c.summary).join(' | ')}`;
                    statusLog.classList.remove('text-gray-400');
                    statusLog.classList.add('text-luxuryGold', 'font-semibold');
                }
            } else {
                if (statusLog) {
                    statusLog.innerText = forceReload
                        ? `Status: All 3 Google Calendars manually refreshed at ${nowStr}.`
                        : `Status: Auto-refreshed all 3 Google Calendars at ${nowStr}${fetchedLiveState ? ' — no new diffs since last poll.' : '.'}`;
                }
            }

            setTimeout(() => {
                if (icon) icon.classList.remove('fa-spin');
            }, 600);
        }

        function showChangeNotification(changes, timeStr) {
            const banner = document.getElementById('change-alert-banner');
            const timeEl = document.getElementById('change-alert-time');
            const detailsEl = document.getElementById('change-alert-details');

            if (timeEl) timeEl.innerText = timeStr;
            if (detailsEl) {
                detailsEl.innerText = `Calendar change detected automatically — ${changes.map(c => c.summary).join(' • ')}`;
            }
            if (banner) {
                banner.classList.remove('hidden');
            }

            // Highlight updated suite badges & cards
            [1, 2, 3].forEach(r => {
                const badge = document.getElementById(`badge-room-${r}`);
                const card = document.getElementById(`cal-card-${r}`);
                const changed = changes.some(c => c.roomNum === r);
                if (badge) badge.classList.toggle('hidden', !changed);
                if (card) {
                    if (changed) {
                        card.classList.add('border-luxuryGold', 'change-alert-glow');
                    } else {
                        card.classList.remove('change-alert-glow');
                    }
                }
            });
        }

        function dismissChangeBanner() {
            const banner = document.getElementById('change-alert-banner');
            if (banner) banner.classList.add('hidden');
            [1, 2, 3].forEach(r => {
                const badge = document.getElementById(`badge-room-${r}`);
                const card = document.getElementById(`cal-card-${r}`);
                if (badge) badge.classList.add('hidden');
                if (card) card.classList.remove('change-alert-glow');
            });
        }

        function triggerManualRefresh() {
            countdownValue = 15;
            const countEl = document.getElementById('countdown-seconds');
            if (countEl) countEl.innerText = countdownValue;
            checkCalendarChangesAndSync(true);
        }

        function toggleAutoRefresh() {
            autoRefreshEnabled = !autoRefreshEnabled;
            const icon = document.getElementById('auto-toggle-icon');
            const text = document.getElementById('auto-toggle-text');
            const ping = document.getElementById('sync-ping');
            const dot = document.getElementById('sync-dot');

            if (autoRefreshEnabled) {
                if (icon) icon.className = 'fas fa-pause mr-1';
                if (text) text.innerText = 'Auto: ON';
                if (ping) ping.classList.remove('hidden');
                if (dot) {
                    dot.classList.remove('bg-yellow-500');
                    dot.classList.add('bg-green-500');
                }
            } else {
                if (icon) icon.className = 'fas fa-play mr-1';
                if (text) text.innerText = 'Auto: PAUSED';
                if (ping) ping.classList.add('hidden');
                if (dot) {
                    dot.classList.remove('bg-green-500');
                    dot.classList.add('bg-yellow-500');
                }
            }
        }

        function startAutoRefreshLoop() {
            if (countdownInterval) clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                if (!autoRefreshEnabled) return;
                countdownValue--;
                if (countdownValue <= 0) {
                    countdownValue = 15;
                    checkCalendarChangesAndSync(false);
                }
                const countEl = document.getElementById('countdown-seconds');
                if (countEl) countEl.innerText = countdownValue;
            }, 1000);
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            if (menu) menu.classList.toggle('hidden');
        }

        function closeMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            if (menu) menu.classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', () => {
            checkCalendarChangesAndSync(false);
            startAutoRefreshLoop();
        });
    </script>
</body>
</html>
